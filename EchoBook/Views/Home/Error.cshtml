@{
    ViewData["Title"] = "Something went wrong";
}

@{
    var statusMessage = ViewBag.StatusMessage as string ?? "Something went wrong on our end.";
}

<div class="landing">
    <h1 class="landing-title">Oops.</h1>
    <p class="landing-tagline">@statusMessage</p>
    <a class="btn btn-outline-light" asp-controller="Home" asp-action="Index">Back to EchoBook</a>
</div>
