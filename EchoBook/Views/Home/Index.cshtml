@model OpenLibraryViewModel
@{
    ViewData["Title"] = "EchoBook - Gateway";
}

<div class="landing-gateway">
    <div class="gateway-card">
        <h1 class="gateway-title">Hello, Welcome to EchoBook</h1>
        <p class="gateway-subtitle">Click button or drag & drop to upload your EPUB book</p>

        <!-- CỤM 1: UPLOAD SÁCH (Có bước bấm nút Upload xác nhận) -->
        <form id="gateway-upload-form" action="/Library/Upload" method="post" enctype="multipart/form-data" class="gateway-section">
            @Html.AntiForgeryToken()
            <label for="gateway-file-input" class="upload-dropzone-large">
                <div class="dropzone-icon">📁</div>
                <div class="dropzone-text" id="gateway-dropzone-label">Drag & drop EPUB file here or click to choose</div>
                <input type="file" id="gateway-file-input" name="epubFile" accept=".epub" hidden />
            </label>
            <!-- Nút Upload đóng vai trò gửi form (chỉ hoạt động khi đã chọn file) -->
            <button type="submit" id="gateway-btn-upload" class="btn-gateway btn-teal" disabled>Upload</button>
        </form>

        <!-- DẢI PHÂN CÁCH -->
        <div class="gateway-divider">
            <span>OR</span>
        </div>

        <!-- CỤM 2: NHẬP KEY LÊN TRÊN, TO LIBRARY XUỐNG DƯỚI -->
        <div class="gateway-section">
            <!-- Nhập Key nằm ở trên -->
            <form action="/Home/OpenLibrary" method="post" class="w-100 mb-3">
                @Html.AntiForgeryToken()
                <div class="key-input-group">
                    <input type="text" name="RecoveryKeyCode" id="user-key-input" class="gateway-input" placeholder="Enter Recovery Key..." required />
                    <button type="submit" class="btn-gateway btn-outline">Enter Key &rarr;</button>
                </div>
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="key-error">@Html.ValidationSummary(true)</div>
                }
            </form>

            <!-- To Library nằm ở dưới -->
            <a href="/Library" class="btn-gateway btn-outline w-100 text-center text-decoration-none">To Library &rarr;</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const fileInput = document.getElementById('gateway-file-input');
            const dropzoneLabel = document.getElementById('gateway-dropzone-label');
            const btnUpload = document.getElementById('gateway-btn-upload');

            if (fileInput) {
                fileInput.addEventListener('change', (e) => {
                    if (e.target.files && e.target.files[0]) {
                        dropzoneLabel.textContent = `Selected: ${e.target.files[0].name}`;
                        dropzoneLabel.style.color = '#00c9a7';
                        // Kích hoạt nút Upload sau khi chọn file
                        if (btnUpload) {
                            btnUpload.removeAttribute('disabled');
                        }
                    }
                });
            }
        });
    </script>
}