@{
    ViewData["Title"] = "Upload EPUB";
}

<div class="landing-gateway">
    <div class="gateway-card">
        <h1 class="gateway-title">Upload EPUB</h1>
        <p class="gateway-subtitle">Choose an .epub file or drag it here</p>

        <!-- SỬA FORM ACTION CHUẨN /Library/Upload -->
        <form id="lib-upload-form" action="/Library/Upload" method="post" enctype="multipart/form-data" class="gateway-section">
            @Html.AntiForgeryToken()
            <label for="lib-file-input" class="upload-dropzone-large">
                <div class="dropzone-icon">📁</div>
                <div class="dropzone-text" id="lib-dropzone-label">Drag & drop EPUB file here or click to choose</div>
                <input type="file" id="lib-file-input" name="epubFile" accept=".epub" hidden />
            </label>

            <button type="submit" id="lib-btn-upload" class="btn-gateway btn-teal" disabled>Upload</button>

            <div class="mt-3">
                <a href="/Library" class="text-dim text-decoration-none">&larr; Back to Library</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const fileInput = document.getElementById('lib-file-input');
            const dropzoneLabel = document.getElementById('lib-dropzone-label');
            const btnUpload = document.getElementById('lib-btn-upload');

            if (fileInput) {
                fileInput.addEventListener('change', (e) => {
                    if (e.target.files && e.target.files[0]) {
                        dropzoneLabel.textContent = `Selected: ${e.target.files[0].name}`;
                        dropzoneLabel.style.color = '#00c9a7';
                        if (btnUpload) {
                            btnUpload.removeAttribute('disabled');
                        }
                    }
                });
            }
        });
    </script>
}